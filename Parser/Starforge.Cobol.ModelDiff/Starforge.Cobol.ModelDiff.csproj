<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Starforge.Cobol.ModelDiff</RootNamespace>
    <AssemblyName>starforge-model-diff</AssemblyName>
    <IsPackable>false</IsPackable>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Starforge.Cobol.Contract.Tests" />
  </ItemGroup>

  <!-- The comparison must go through the application's own readers, so it references the application. -->
  <ItemGroup>
    <ProjectReference Include="..\..\CobolToQuarkusMigration.csproj" />
  </ItemGroup>

</Project>
